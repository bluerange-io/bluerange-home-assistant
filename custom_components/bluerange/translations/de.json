{
  "config": {
    "step": {
      "user": {
        "title": "Mit BlueRange verbinden",
        "description": "Gib die Adresse deines BlueRange-Servers und ein API-Token ein. Tokens werden im BlueRange-Portal auf der Profilseite des Benutzers erzeugt.",
        "data": {
          "url": "Server-URL",
          "access_token": "API-Token",
          "verify_ssl": "TLS-Zertifikat prüfen"
        },
        "data_description": {
          "url": "Die Adresse deines BlueRange-Servers, z. B. das Portal oder ein On-Premise-Host.",
          "access_token": "Wird als Header X-User-Access-Token an den Server gesendet.",
          "verify_ssl": "Nur für Server mit selbst ausgestelltem Zertifikat abschalten."
        }
      },
      "organization": {
        "title": "Organisation wählen",
        "description": "Dieses API-Token hat Zugriff auf mehrere BlueRange-Organisationen. Wähle die zu übernehmende; für weitere einen zusätzlichen Eintrag anlegen.",
        "data": {
          "organization": "Organisation"
        }
      },
      "reauth_confirm": {
        "title": "BlueRange-API-Token erneuern",
        "description": "Das Token für {url} wird nicht mehr akzeptiert. Gib ein neues ein.",
        "data": {
          "access_token": "API-Token"
        }
      },
      "reconfigure": {
        "title": "BlueRange-Verbindung ändern",
        "data": {
          "url": "Server-URL",
          "access_token": "API-Token",
          "verify_ssl": "TLS-Zertifikat prüfen"
        }
      }
    },
    "error": {
      "cannot_connect": "Der Server ist nicht erreichbar.",
      "invalid_auth": "Der Server hat das API-Token abgelehnt.",
      "invalid_url": "Das ist keine gültige Server-URL.",
      "no_organizations": "Dieses API-Token hat Zugriff auf keine Organisation.",
      "unknown": "Unerwarteter Fehler bei der Kommunikation mit dem Server."
    },
    "abort": {
      "already_configured": "Diese BlueRange-Organisation ist bereits eingerichtet.",
      "reauth_successful": "Das API-Token wurde aktualisiert.",
      "reconfigure_successful": "Die Verbindung wurde aktualisiert.",
      "wrong_account": "Dieses Token gehört zu einer anderen BlueRange-Organisation."
    }
  },
  "options": {
    "step": {
      "init": {
        "title": "BlueRange-Optionen",
        "data": {
          "use_mqtt": "Live-Updates über MQTT",
          "scan_interval": "Aktualisierungsintervall"
        },
        "data_description": {
          "use_mqtt": "Abonniert den BlueRange-Message-Broker, damit Messwerte sofort ankommen. Abschalten, um nur zu pollen. Server ohne Broker fallen von selbst auf Polling zurück.",
          "scan_interval": "Wie oft der Server abgefragt wird. Pro Durchlauf wird eine Anfrage je Gerät gesendet, bei großen Installationen also höher setzen. Solange Live-Updates ankommen, ist das Polling nur ein Sicherheitsnetz und läuft höchstens alle 15 Minuten."
        }
      }
    }
  },
