{
  "config": {
    "step": {
      "user": {
        "title": "Connect to BlueRange",
        "description": "Enter the address of your BlueRange server and an API token. Tokens are created in the BlueRange portal on your user profile page.",
        "data": {
          "url": "Server URL",
          "access_token": "API token",
          "verify_ssl": "Verify the TLS certificate"
        },
        "data_description": {
          "url": "The address of your BlueRange server, e.g. the portal or an on-premise host.",
          "access_token": "Sent to the server as the X-User-Access-Token header.",
          "verify_ssl": "Turn this off only for servers with a self-signed certificate."
        }
      },
      "organization": {
        "title": "Choose the organisation",
        "description": "This API token has access to more than one BlueRange organisation. Pick the one to mirror; add another config entry for the others.",
        "data": {
          "organization": "Organisation"
        }
      },
      "reauth_confirm": {
        "title": "Renew the BlueRange API token",
        "description": "The token for {url} is no longer accepted. Enter a new one.",
        "data": {
          "access_token": "API token"
        }
      },
      "reconfigure": {
        "title": "Change the BlueRange connection",
        "data": {
          "url": "Server URL",
          "access_token": "API token",
          "verify_ssl": "Verify the TLS certificate"
        }
      }
    },
    "error": {
      "cannot_connect": "Could not reach the server.",
      "invalid_auth": "The server rejected the API token.",
      "invalid_url": "This is not a valid server URL.",
      "no_organizations": "This API token has access to no organisation.",
      "unknown": "Unexpected error while talking to the server."
    },
    "abort": {
      "already_configured": "This BlueRange organisation is already set up.",
      "reauth_successful": "The API token was updated.",
      "reconfigure_successful": "The connection was updated.",
      "wrong_account": "This token belongs to a different BlueRange organisation."
    }
  },
  "options": {
    "step": {
      "init": {
        "title": "BlueRange options",
        "data": {
          "use_mqtt": "Live updates over MQTT",
          "scan_interval": "Update interval"
        },
        "data_description": {
          "use_mqtt": "Subscribes to the BlueRange message broker so readings arrive as they happen. Turn this off to poll only. Servers without a broker fall back to polling by themselves.",
          "scan_interval": "How often the server is polled. One request per device is sent per cycle, so raise this value for large installations. While live updates arrive, polling is only a safety net and happens at most every 15 minutes."
        }
      }
    }
  },
