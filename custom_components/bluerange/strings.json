  "services": {
    "set_actuator": {
      "name": "Set actuator",
      "description": "Writes a value to a BlueRange actuator directly. Useful for vendor specific actuators that have no entity of their own.",
      "fields": {
        "device_id": {
          "name": "Device",
          "description": "The BlueRange device to write to."
        },
        "control_type": {
          "name": "Actuator type",
          "description": "The BlueRange actuator type, for example SET_SETPOINT_TEMPERATURE."
        },
        "index": {
          "name": "Index",
          "description": "The channel of the actuator, for devices that expose the same type more than once."
        },
        "module": {
          "name": "Module",
          "description": "The firmware module owning the actuator. Leave empty to use the one from the device metadata."
        },
        "value": {
          "name": "Value",
          "description": "The value to write."
        }
      }
    }
  },
  "exceptions": {
    "device_not_found": {
      "message": "No device found for {device_id}."
    },
    "not_a_bluerange_device": {
      "message": "{device_id} is not a BlueRange device."
    },
    "unsupported_hvac_mode": {
      "message": "This thermostat does not support the mode {hvac_mode}."
    },
    "unsupported_preset_mode": {
